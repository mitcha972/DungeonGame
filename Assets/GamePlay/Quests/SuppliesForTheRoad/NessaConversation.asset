  m_Script: {fileID: 11500000, guid: bc3cb1b1c1fbdfb42b12a08b6413be21, type: 3}
  m_Name: NessaConversation
  m_EditorClassIdentifier: Assembly-CSharp::DungeonGame.Dialogue.DialogueConversation
  entryNode: offer
  conditionalEntries:
  - nodeId: complete
    conditions:
    - {fileID: 11400000, guid: 1a53a8e75aa1e5c4dbe9a784862a582a, type: 2}
  - nodeId: draught
    conditions:
    - {fileID: 11400000, guid: daf8c7cb290390440aa01d661b0b3427, type: 2}
