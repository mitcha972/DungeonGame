  m_Script: {fileID: 11500000, guid: 4d90a0bc3761862428177089b7dda729, type: 3}
  m_Name: SuppliesForTheRoad
  m_EditorClassIdentifier: Assembly-CSharp::DungeonGame.Quests.QuestDefinition
  id: supplies-for-the-road
  title: Supplies for the Road
  summary: Quartermaster Nessa needs firewood, copper for repairs, and a healing
    draught before the next expedition.
  minimumLevel: 1
  prerequisites: []
  stages:
  - id: camp-supplies
    journal: Bring Nessa two logs and one copper ore. Chop trees and mine the copper
      rocks in the test yard; supplies already in your bag also count.
    objectives:
    - id: logs
      description: Bring two logs
      type: 0
      count: 2
      item: {fileID: 11400000, guid: be8f56e1f534c7649b7c5abed104b270, type: 2}
      enemy: {fileID: 0}
      targetId: 
      consumeOnTurnIn: 1
    - id: copper
      description: Bring one copper ore
      type: 0
      count: 1
      item: {fileID: 11400000, guid: be3d7ba1f2c73ee409d5a9e1b62fdeb5, type: 2}
      enemy: {fileID: 0}
      targetId: 
      consumeOnTurnIn: 1
  - id: healing-draught
    journal: The repairs are covered. Fill a healing potion at the spring and bring
      it to Nessa. Leave one extra bag slot free for her reward.
    objectives:
    - id: potion
      description: Bring one healing potion
      type: 0
      count: 1
      item: {fileID: 11400000, guid: 7c97d7ec76b3ade40a27d7e4c5fa9336, type: 2}
      enemy: {fileID: 0}
      targetId: 
      consumeOnTurnIn: 1
  experienceReward: 75
  itemRewards:
  - item: {fileID: 11400000, guid: 7c97d7ec76b3ade40a27d7e4c5fa9336, type: 2}
    count: 2
