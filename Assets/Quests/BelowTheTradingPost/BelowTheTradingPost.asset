    objectives:
    - id: watch-post
      description: Discover the old watch post
      type: 2
      count: 1
      item: {fileID: 0}
      enemy: {fileID: 0}
      targetId: old-watch-post
      consumeOnTurnIn: 0
    - id: ledger
